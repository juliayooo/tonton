# =========================================================================
# React Project .gitignore Template
# =========================================================================

# Dependencies
# -------------------------------------------------------------------------
node_modules/
/jspm_packages
/web_modules

# Production Build Artifacts
# -------------------------------------------------------------------------
/build
/dist
/out
/.next
/target
/public/build

# Logs and Diagnostics
# -------------------------------------------------------------------------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Environment Variables & Secrets (NEVER commit these!)
# -------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env.json

# Code Coverage & Testing
# -------------------------------------------------------------------------
/coverage
/.nyc_output

# Editor & IDE Specific Files
# -------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.eslintcache

# Operating System Files
# -------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# TypeScript Cache
# -------------------------------------------------------------------------
*.tsbuildinfo